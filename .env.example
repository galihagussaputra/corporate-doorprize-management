# ---------------------------------------------------------------------------
# Copy to .env.local (app) and/or .env (Supabase CLI). NEVER commit real values.
# ---------------------------------------------------------------------------

# Local Supabase CLI defaults (from `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-start

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never import from a client component.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key-from-supabase-start

# Optional: direct DB connection for seed/integration scripts
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public origin of this app (used in docs and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
